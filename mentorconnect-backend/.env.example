# MentorConnect Backend Configuration

SECRET_KEY=mentorconnect-secret-key-development-secure-token-2026
DEBUG=True

# Database Configuration (PostgreSQL)
# Set POSTGRES_DB to connect to your PostgreSQL instance.
# If unset or empty, the application seamlessly defaults to SQLite for local development.
POSTGRES_DB=mentorconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
